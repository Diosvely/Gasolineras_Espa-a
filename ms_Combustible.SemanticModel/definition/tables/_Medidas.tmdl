		isNameInferred
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = User

	partition _Medidas = calculated
		mode: import
		source = ROW("Placeholder", BLANK())

	annotation PBI_Id = a41b572d03964357a6ad88e1c5374b26

